# Copy to .env and adjust for local dev
QD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
QD_EMBEDDINGS_PATH=data/reciters_embeddings.npy
QD_MAX_UPLOAD_MB=25
QD_LIVE_CONFIDENCE_THRESHOLD=0.85

# Export once before serving (see docs/onnx-deployment.md)
QD_RECITER_ONNX_PATH=data/models/reciter.onnx
QD_INFERENCE_THREADS=2

# Optional small-memory profile; allocator environment must be set at startup.
# See docs/memory-512.md. Docker sets these automatically.
QD_LOW_MEMORY=false
